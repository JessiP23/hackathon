# Postgres URI: postgresql://... or postgres://... (never https://).
# Supabase from Docker: use Transaction pooler only (port 6543, *.pooler.supabase.com).
#   Direct db.<project>.supabase.co:5432 is IPv6-only DNS — Docker Desktop usually fails with "Network is unreachable".
#   Dashboard → Database → Connection string → Transaction pooler; user often postgres.<project_ref>
#   Append sslmode=require if needed.
# Docker local Postgres (profile local-db): postgresql://infrastreet:infrastreet@postgres:5432/infrastreet
# Native local Postgres: postgresql://infrastreet:infrastreet@localhost:5432/infrastreet
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Docker Desktop often cannot reach Supabase over IPv6; backend resolves an IPv4 hostaddr automatically when /.dockerenv exists. Set to 0 to disable, 1 to force (even outside Docker).
# DATABASE_FORCE_IPV4=0
REDIS_URL=redis://localhost:6379
MCP_SERVER_URL=http://localhost:3001/mcp
CORS_ORIGINS=http://localhost:3000
# Production frontend URL(s) must be listed here or Safari preflight will fail with OPTIONS 400.
# Example: CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Optional: allow all *.vercel.app and *.fly.dev (regex) when you use many preview URLs
# CORS_ORIGIN_REGEX=^https://(.+\.vercel\.app|.+\.fly\.dev|localhost:\d+)$
REFERRAL_POINTS_REFERRER=200
REFERRAL_POINTS_REFEREE=100
FRONTEND_URL=http://localhost:3000
# Platform fee on deal food subtotal (e.g. 0.15 = 15%). Must match checkout UI label.
SERVICE_FEE_RATE=0.15
# Twilio signature check must match this exact public origin (no trailing slash).
# Fly: https://infrastreet-api.fly.dev   Local: https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

GROQ_API_KEY=

# Menu OCR: Paddle (recommended) then Groq vision fallback
USE_PADDLE_OCR=1
PADDLE_OCR_LANG=es

# POST /customers/notify_opt_in — OTP stored in Redis
NOTIFY_OTP_TTL_SECONDS=600

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Easiest path: ONE Messaging Service + ONE phone number → set only this (MG...):
TWILIO_MESSAGING_SERVICE_SID=
# Optional overrides (two pools later): if unset, falls back to TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID_VENDOR=
TWILIO_MESSAGING_SERVICE_SID_CUSTOMER=

STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   URL: https://<your-public-api-host>/webhook/stripe
#   Events: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed
# Then reveal Signing secret (whsec_...) and paste below (not the same as STRIPE_SECRET_KEY).
STRIPE_WEBHOOK_SECRET=

# Telegram — vendors DM @YourBot. Webhook: POST /telegram/webhook
# Set webhook with secret: BotFather setWebhook URL + secret_token
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# SMS/notifications: short links resolve at GET /d/{code}. Use API origin so texts stay short:
# SHORT_LINK_BASE=https://infrastreet-api.fly.dev
SHORT_LINK_BASE=
SHORT_LINK_TTL_SECONDS=7776000

B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=infrastreet-bucket
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
